{
  "name": "tweakerzzz",
  "version": "0.2.1",
  "private": true,
  "description": "A considered control center for Windows gaming and content creation.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "studio.tweakerzzz.desktop",
    "productName": "Tweakerzzz",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/windows/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "scripts/windows",
        "to": "windows",
        "filter": [
          "*.ps1",
          "*.json"
        ]
      }
    ]
  }
}
