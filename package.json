{
  "name": "tweakerzzz",
  "version": "0.7.3",
  "private": true,
  "description": "A considered control center for Windows gaming and content creation.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run prepare:color && npm run prepare:collector && npm run build && electron-builder --win nsis --x64",
    "verify:package": "node scripts/verify-package.cjs",
    "prepare:collector": "node scripts/prepare-presentmon.cjs",
    "prepare:color": "node scripts/prepare-color.cjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "studio.tweakerzzz.desktop",
    "productName": "Tweakerzzz",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/windows/**/*",
      "package.json",
      "vendor/presentmon/LICENSE.txt"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tweakerzzz",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "scripts/windows",
        "to": "windows",
        "filter": [
          "*.ps1",
          "*.json"
        ]
      },
      {
        "from": "vendor/presentmon",
        "to": "presentmon",
        "filter": [
          "*.exe",
          "LICENSE.txt"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "app.ico"
      },
      {
        "from": "build/color",
        "to": "color",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "artifactName": "Tweakerzzz-Setup-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "marajdesigns215-dot",
      "repo": "tweakerzzz",
      "releaseType": "prerelease"
    },
    "releaseInfo": {
      "releaseNotesFile": "docs/UPDATE_NOTES.md"
    }
  }
}
